PROJECT_STATE.md

# Go build artifacts (binaries are always built into bin/ — see how the
# project is built in PROJECT_STATE.md. A bare "swarmdialer" pattern here
# previously also matched the cmd/swarmdialer/ SOURCE directory and kept it
# out of git entirely since the first commit — fixed by scoping to /bin/ only.)
/bin/
*.exe

# Provisioning/load-test output — contains SIP secrets
extensions*.json

# SwarmDialer GUI's per-deployment config store — contains PBXware API
# keys and provisioned extension secrets, generated fresh by the Setup
# Wizard on each deployment. Never part of the repo (see docs/gui_spec.md's
# portability requirement).
swarmdialer_config*.json

# Per-deployment call-batch logs (see internal/logstore) — runtime output,
# not part of the repo, same reasoning as swarmdialer_config*.json above.
/logs/

